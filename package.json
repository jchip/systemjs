{
  "name": "systemjs",
  "version": "6.14.2",
  "description": "Dynamic ES module loader",
  "repository": {
    "type": "git",
    "url": "git://github.com/systemjs/systemjs"
  },
  "author": "Guy Bedford",
  "contributors": [],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "chomp build",
    "tf": "mocha test/system-core.ts",
    "xtest": "chomp test",
    "prepublishOnly": "xrun --serial [[build, docs], xarc/check]",
    "docs": "xrun xarc/docs",
    "test": "xrun xarc/test-only",
    "coverage": "xrun xarc/test-cov"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@jsenv/file-size-impact": "^5.2.0",
    "@rollup/plugin-json": "^4.0.2",
    "@rollup/plugin-node-resolve": "^7.1.1",
    "@rollup/plugin-replace": "^2.4.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@swc/cli": "^0.6.0",
    "@types/chai": "^4.3.9",
    "@types/jest": "^29.5.6",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.8.9",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.11",
    "@vercel/ncc": "^0.34.0",
    "@xarc/module-dev": "^5.0.0",
    "bluebird": "^3.7.2",
    "chai": "^4.3.10",
    "chomp": "^0.2.23",
    "construct-style-sheets-polyfill": "^2.3.5",
    "jest": "^29.7.0",
    "kleur": "^4.1.5",
    "mkdirp": "^1.0.4",
    "mocha": "^10.2.0",
    "node-fetch": "^2.6.0",
    "nyc": "^15.1.0",
    "open": "^8.4.0",
    "prettier": "^3.0.3",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^5.3.0",
    "sinon": "^17.0.0",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "symbol-es6": "^0.1.2",
    "terser": "^5.16.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.2",
    "typescript": "^5.2.2",
    "whatwg-fetch": "^3.0.0"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/systemjs"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "@xarc/module-dev": {
    "features": [
      "jest",
      "jestTS",
      "mocha",
      "prettier",
      "typedoc",
      "typescript"
    ]
  },
  "nyc": {
    "extends": [
      "@istanbuljs/nyc-config-typescript"
    ],
    "all": true,
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "exclude": [
      "*clap.js",
      "*clap.ts",
      ".eslintrc.js",
      "coverage",
      "dist",
      "docs",
      "gulpfile.js",
      "test",
      "xrun*.js",
      "xrun*.ts"
    ],
    "check-coverage": true,
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100,
    "cache": false
  },
  "jest": {
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "mocha": {
    "require": [
      "ts-node/register",
      "source-map-support/register",
      "@xarc/module-dev/config/test/setup.js"
    ],
    "recursive": true
  }
}
