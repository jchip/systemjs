{
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "es2018",
      "DOM"
    ],
    "module": "nodenext",
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "ES2018",
    "preserveConstEnums": true,
    "sourceMap": true,
    "declaration": true,
    "types": [
      "node",
      "jest",
      "mocha",
      "chai",
      "sinon",
      "sinon-chai"
    ],
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true
  },
  "include": [
    "src"
  ]
}
