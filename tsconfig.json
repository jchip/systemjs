{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES5", "ES2015.Core", "ES2015.Promise", "ES2015.Symbol", "ES2015.Symbol.WellKnown", "ES2015.Iterable", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
